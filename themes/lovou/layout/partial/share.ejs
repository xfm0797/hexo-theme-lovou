<% if (theme.share === true && (is_post() ? page.share !== false : page.share === true)) { %>
<%
  const shareUrl = encodeURIComponent(full_url_for(page.path));
  const shareTitle = encodeURIComponent(page.title + ' · ' + config.title);
%>
<div class="post-share">
  <span class="share-label">分享到</span>
  <div class="share-buttons">
    <a class="share-btn" target="_blank" rel="noopener" title="分享到微信"
       href="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=<%= shareUrl %>"
       onclick="event.preventDefault();var d=this.nextElementSibling;d.classList.toggle('visible')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8.7 3C4.9 3 2 5.4 2 8.4c0 1.7.9 3.2 2.4 4.3l-.6 1.8 2.1-1.1c.6.1 1.1.2 1.8.2h.5c-.1-.4-.2-.9-.2-1.3 0-2.8 2.8-5 6-5h.5C14.1 4.6 11.7 3 8.7 3zm-2.4 3.6c.4 0 .8.3.8.8s-.4.7-.8.7-.8-.3-.8-.8.4-.7.8-.7zm4.8 0c.4 0 .8.3.8.8s-.4.7-.8.7-.8-.3-.8-.7.4-.8.8-.8z"/><path d="M22 12.3c0-2.6-2.5-4.7-5.5-4.7s-5.5 2-5.5 4.7 2.5 4.6 5.5 4.6c.5 0 1.1-.1 1.6-.2l1.8.9-.5-1.5c1.5-.9 2.6-2.3 2.6-3.8zm-7.3-1.5c-.4 0-.7-.3-.7-.7s.3-.7.7-.7.8.3.8.7-.4.7-.8.7zm3.7 0c-.4 0-.8-.3-.8-.7s.4-.7.8-.7.7.3.7.7-.3.7-.7.7z"/></svg>
      微信
    </a>
    <a class="share-btn" target="_blank" rel="noopener" title="分享到微博"
       href="https://service.weibo.com/share/share.php?url=<%= shareUrl %>&title=<%= shareTitle %>">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M10.9 19.6c-3.2.3-6-.9-6.2-2.8-.2-1.9 2.2-3.7 5.4-4 3.2-.3 6 .9 6.2 2.8.2 1.9-2.2 3.7-5.4 4zm.5-3.9c-1.5.2-2.7 1-2.6 1.9.1.9 1.5 1.4 3 1.2 1.5-.2 2.7-1 2.6-1.9-.1-.9-1.5-1.4-3-1.2zm-3-4.4c-3.4.6-6 2.8-5.7 5 .1.9.7 1.6 1.6 2.1-1.2-.5-2-1.4-2.1-2.6-.3-2.6 2.7-5.3 6.7-6 4.4-.8 8.3.7 8.6 3.3.1.7-.1 1.4-.5 2 .6-2.8-2.5-5.5-8.6-3.8z"/><path d="M17.9 6.5c1.5.4 2.5 1.4 2.3 2.9l-.7 3.3c1.4-1.6 2.1-3.5 1.8-5.2C41 4.4 17.7 5 17.9 6.5zm1.8 4.4c.4-1.8-.6-3.5-2.5-4.3-2.6-1.1-6.1-.4-8.1 1.5-.5.5-.9 1-1.1 1.6 2-2.1 5.4-3 8.2-2.1 2 .6 3.6 2.2 4.1 4.1l-.6 1.2z"/></svg>
      微博
    </a>
    <a class="share-btn" target="_blank" rel="noopener" title="分享到 X"
       href="https://twitter.com/intent/tweet?url=<%= shareUrl %>&text=<%= shareTitle %>">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.4L6 22H2.9l7.3-8.3L1.5 2h6.4l4.4 5.9L18.9 2zm-1.1 18h1.7L7.1 3.9H5.3L17.8 20z"/></svg>
      X
    </a>
    <a class="share-btn" target="_blank" rel="noopener" title="分享到 Telegram"
       href="https://t.me/share/url?url=<%= shareUrl %>&text=<%= shareTitle %>">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M21.9 4.6c.3-1.2-.9-2.2-2-1.7L2.7 9.6c-1.3.5-1.2 2.4.1 2.8l4.6 1.4 1.7 5.4c.4 1.1 1.7 1.4 2.5.5l2.5-2.6 4.7 3.5c.9.7 2.2.2 2.4-1L21.9 4.6zM8.2 13.6l8.9-5.5c.4-.2.8.3.4.6l-7.4 6.8-.3 3-1.6-4.9z"/></svg>
      Telegram
    </a>
    <button class="share-btn" type="button" title="复制链接"
       onclick="navigator.clipboard.writeText(decodeURIComponent('<%= shareUrl %>')).then(function(){var t=this;this.classList.add('copied');var s=this.querySelector('.share-copied');s.textContent='已复制';setTimeout(function(){t.classList.remove('copied');s.textContent='复制链接'},1500)}.bind(this))">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
      <span class="share-copied">复制链接</span>
    </button>
  </div>
</div>
<% } %>

<div class="post-list">
  <%
    const adsense = theme.adsense || {};
    const every = parseInt(adsense.index_every, 10) || 0;
    const showListAd = adsense.enable && adsense.client && adsense.index_slot && every > 0 && !adsense.auto;
    let postIndex = 0;
  %>
  <% page.posts.each(function (post) { %>
    <% postIndex += 1; %>
    <article class="post-item">
      <h2 class="post-item-title">
        <a href="<%- url_for(post.path) %>"><%= post.title %></a>
      </h2>
      <div class="post-item-meta">
        <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
        <% if (post.categories && post.categories.length) { %>
          <span class="meta-sep">·</span>
          <% post.categories.each(function (cat, i) { %>
            <% if (i > 0) { %><span class="meta-sep">/</span><% } %>
            <a class="post-item-cat" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
          <% }); %>
        <% } %>
      </div>
      <%
        const excerpt = post.excerpt || post.content;
        const isAuto = !post.excerpt;
      %>
      <p class="post-item-excerpt"><%= isAuto ? trim_excerpt(excerpt) : trim_excerpt(excerpt, 200) %></p>
      <a class="post-item-more" href="<%- url_for(post.path) %>">阅读全文 →</a>
    </article>
    <% if (showListAd && postIndex % every === 0) { %>
    <%- partial('partial/adsense', { slot: adsense.index_slot, label: '列表广告', className: 'adsense-list' }) %>
    <% } %>
  <% }); %>
</div>

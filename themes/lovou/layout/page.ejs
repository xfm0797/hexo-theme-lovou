<% if (page.type === 'categories') { %>
  <div class="taxonomy">
    <h1 class="page-title"><%= page.title || __('page.categories') %></h1>
    <% if (site.categories.length) { %>
    <ul class="category-list">
      <% site.categories.sort('name').each(function (cat) { %>
        <li>
          <a class="category-list-link" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
          <span class="category-list-count"><%= cat.posts.length %></span>
        </li>
      <% }); %>
    </ul>
    <% } else { %>
    <p class="empty-tip"><%= __('page.empty') %></p>
    <% } %>
  </div>
<% } else if (page.type === 'tags') { %>
  <div class="taxonomy">
    <h1 class="page-title"><%= page.title || __('page.tags') %></h1>
    <% if (site.tags.length) { %>
    <div class="tag-cloud">
      <% site.tags.sort('name').each(function (tag) { %>
        <a class="tag" href="<%- url_for(tag.path) %>"># <%= tag.name %><span class="tag-count"><%= tag.posts.length %></span></a>
      <% }); %>
    </div>
    <% } else { %>
    <p class="empty-tip"><%= __('page.empty') %></p>
    <% } %>
  </div>
<% } else { %>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title"><%= page.title %></h1>
      <div class="post-meta">
        <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      </div>
    </header>
    <div class="post-content">
      <%- page.content %>
    </div>
  </article>
<% } %>
